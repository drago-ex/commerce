{
	"name": "drago-ex/commerce",
	"description": "Simple shopping cart.",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Zdeněk Papučík",
			"homepage": "https://github.com/accgit"
		}
	],
	"require": {
		"php": ">=8.3 <9",
		"ext-intl": "*",
		"latte/latte": "^3.1",
		"nette/application": "^3.2",
		"nette/di": "^3.0",
		"nette/mail": "^4.0",
		"drago-ex/application": "^4.0",
		"drago-ex/database": "^4.1",
		"drago-ex/form": "^3.0",
		"brick/money": "^0.15",
		"brick/postcode": "^0.6",
		"nepada/phone-number-input": "^1.0",
		"tracy/tracy": "^2.10",
		"brick/math": "^1.0",
		"brick/phonenumber": "^0.8.0",
		"dibi/dibi": "^5.1"
	},
	"suggest": {
		"drago-ex/translator": "Loads the bundled translations automatically from the directory declared in extra.drago-translator.",
		"geoip2/geoip2": "Enables automatic phone-region detection from the visitor's IP via a MaxMind GeoLite2 City database you provide yourself (see README, 'geoLite2Path' config option)."
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2.0",
		"geoip2/geoip2": "^2.12"
	},
	"autoload": {
		"classmap": [
			"src/"
		],
		"psr-4": {
			"Drago\\": "src"
		}
	},
	"extra": {
		"drago-translator": {
			"translation": "src/Commerce/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C"
	}
}
