{templateType Drago\Commerce\UI\ShoppingCart\MiniCartTemplate}

{*
	Mini shopping cart summary component with shop name on the left
	and cart icon with item count and total price on the right.
*}

<div class="d-flex justify-content-between align-items-center border-bottom pb-2">

	{* Mini cart on the right *}
	{var $linkAttrs = [
		'href' => $linkShoppingCart,
		'class' => "d-flex align-items-center text-decoration-none text-body-emphasis pe-3"
	]}

	<a n:attr="$linkAttrs" aria-label="{_'Go to shopping cart'}: {$amountItems} {_'items'}, {_'total price'} {$formattedTotalPrice}">

		<div class="commerce-mini-cart-icon position-relative">
			<i class="fa fa-shopping-cart"></i>

			{* Show badge only if cart has items *}
			{if $amountItems > 0}
				<span class="commerce-mini-cart-badge position-absolute start-100 translate-middle badge rounded-pill bg-danger border border-white"
					  aria-live="polite">
					{$amountItems}
				</span>
			{/if}
		</div>

		<span class="fw-semibold ms-3" aria-atomic="true">
			{$formattedTotalPrice}
		</span>
	</a>
</div>
