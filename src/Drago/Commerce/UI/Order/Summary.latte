{templateType Drago\Commerce\UI\Order\SummaryOrderTemplate}
{import '../@breadcrumbs.latte'}
{import '../@orderSummarySidebar.latte'}

{if count($shoppingCart)}

	{include breadcrumbs, $breadcrumbs}

	<h1 class="h4 mb-4 d-flex align-items-center gap-2">
		<i class="fa-solid fa-clipboard-check text-body-secondary" aria-hidden="true"></i>
		{_'Pre-shipment summary'}
	</h1>

	<div class="row g-4">

		{* Left column: itemized review + customer info *}
		<div class="col-lg-8">

			<div class="card border-0 shadow-sm mb-4">
				<div class="card-body">
					<div class="table-responsive">
						<table class="table table-borderless align-middle mb-0">
							<thead>
							<tr>
								<th scope="col"><small>{_'Product name'}</small></th>
								<th scope="col" class="text-end"><small>{_'Price'}</small></th>
								<th scope="col" class="text-center"><small>{_'Amount'}</small></th>
								<th scope="col" class="text-end"><small>{_'Discount'}</small></th>
							</tr>
							</thead>
							<tbody>

							<tr n:foreach="$shoppingCart as $cart">
								<td>{$cart->product->name}</td>
								<td class="text-end text-nowrap">{$cart->product->getDiscountedPrice()|money}</td>
								<td class="text-center">{$cart->amount}</td>
								<td class="text-end text-nowrap">
									<span n:if="$cart->product->hasDiscount()" class="badge border border-danger-subtle text-danger">
										-{$cart->product->discount}%
									</span>
								</td>
							</tr>

							</tbody>
						</table>
					</div>
				</div>
			</div>

			<h2 class="h5 mb-3 d-flex align-items-center gap-2">
				<i class="fa-solid fa-address-card text-body-secondary" aria-hidden="true"></i>
				{_'Customer information'}
			</h2>
			<div class="card border-0 shadow-sm">
				<div class="card-body">
					<div class="row gy-3">
						<div class="col-md-6">
							<strong class="fw-semibold d-block mb-1">{_'Name and surname'}</strong>
							{$customer->name} {$customer->surname}
						</div>
						<div class="col-md-6">
							<strong class="fw-semibold d-block mb-1">{_'Email'}</strong>
							{$customer->email}
						</div>
						<div class="col-md-6">
							<strong class="fw-semibold d-block mb-1">{_'Telephone'}</strong>
							{$customer->phone->format(Brick\PhoneNumber\PhoneNumberFormat::INTERNATIONAL)}
						</div>
						<div class="col-md-6">
							<strong class="fw-semibold d-block mb-1">{_'Delivery address'}</strong>
							{$customer->street}<br>
							{$customer->postal_code} {$customer->city}<br>
							{$customer->country}
						</div>
						<div class="col-12" n:if="$customer->note">
							<strong class="fw-semibold d-block mb-1">{_'Order note'}</strong>
							{$customer->note ?? null}
						</div>
					</div>
				</div>
			</div>

		</div>

		{* Right column: price breakdown + confirm button, stays in view *}
		<div class="col-lg-4">
			{include orderSummarySidebar,
				amountItems: $amountItems,
				totalPrice: $totalPrice,
				carrier: $carrier,
				payment: $payment,
				originalPrice: $originalPrice,
				productDiscountAmount: $productDiscountAmount,
				subtotalPrice: $subtotalPrice,
				discountCode: $discountCode,
				discountAmount: $discountAmount,
				showConfirmOrder: true,
				canConfirmOrder: $customer !== null && $carrier !== null && $payment !== null,
			}
		</div>

	</div>

{else}
	<p>{_'Your shopping cart is empty.'}</p>
{/if}
