{define orderSummarySidebar,
	int $amountItems,
	\Brick\Money\Money $totalPrice,
	?\Drago\Commerce\Domain\Delivery\Carrier $carrier = null,
	?\Drago\Commerce\Domain\Delivery\Payment $payment = null,
	?\Brick\Money\Money $originalPrice = null,
	?\Brick\Money\Money $productDiscountAmount = null,
	?\Brick\Money\Money $subtotalPrice = null,
	?string $discountCode = null,
	?\Brick\Money\Money $discountAmount = null,
	?string $note = null,
	?string $continueUrl = null,
	bool $showContinueForm = false,
	bool $showConfirmOrder = false,
	bool $canConfirmOrder = false,
}
	<div class="shop-summary-sticky">
		<div class="card border-0 shadow-sm">
			<div class="card-body">
				<p class="fw-semibold d-flex align-items-center gap-2 mb-3">
					<i class="fa-solid fa-receipt text-body-secondary" aria-hidden="true"></i>
					{_'Order summary'}
				</p>

				<div class="d-flex justify-content-between mb-2">
					<span class="text-body-secondary">{_'Items'}:</span>
					<span>{$amountItems}</span>
				</div>

				<div n:if="$originalPrice !== null && $productDiscountAmount !== null && !$productDiscountAmount->isZero()" class="d-flex justify-content-between mb-2">
					<span class="text-body-secondary">{_'Price without discount'}:</span>
					<span>{$originalPrice|money}</span>
				</div>

				<div n:if="$productDiscountAmount !== null && !$productDiscountAmount->isZero()" class="d-flex justify-content-between mb-2 text-success">
					<span>{_'Product discounts'}:</span>
					<span>-{$productDiscountAmount|money}</span>
				</div>

				<div n:if="$subtotalPrice !== null" class="d-flex justify-content-between mb-2">
					<span class="text-body-secondary">{_'Subtotal'}:</span>
					<span>{$subtotalPrice|money}</span>
				</div>

				<div n:if="$discountCode && $discountAmount !== null && !$discountAmount->isZero()" class="d-flex justify-content-between mb-2 text-success">
					<span>{_'Discount'} ({$discountCode}):</span>
					<span>-{$discountAmount|money}</span>
				</div>

				<div n:if="$carrier !== null" class="d-flex justify-content-between mb-2">
					<span class="text-body-secondary">{_'Carrier'}: {$carrier->name}</span>
					<span>{$carrier->price|money}</span>
				</div>

				<div n:if="$payment !== null" class="d-flex justify-content-between mb-2">
					<span class="text-body-secondary">{_'Payment'}: {$payment->name}</span>
					<span>{$payment->price|money}</span>
				</div>

				<div class="d-flex justify-content-between border-top pt-2">
					<span class="fw-bold fs-5">{_'Total to pay'}:</span>
					<span class="fw-bold fs-5 text-shop-accent">{$totalPrice|money}</span>
				</div>

				<p n:if="$note" class="small text-body-secondary mt-3 mb-0">
					<i class="fa-solid fa-circle-info" aria-hidden="true"></i>
					{$note|translate}
				</p>

				<a n:if="$continueUrl !== null" href="{$continueUrl}" class="btn btn-shop-accent w-100 mt-2 d-flex align-items-center justify-content-center gap-2">
					{_'Continue with order'}
					<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
				</a>

				<input n:if="$showContinueForm" n:name="send" class="btn btn-shop-accent w-100 mt-2" />

				<form n:if="$showConfirmOrder && $canConfirmOrder" n:name="sendOrder" class="mt-2">
					<input n:name="send" class="btn btn-success w-100" aria-label="{_'Confirm your order and complete the purchase'}" />
				</form>
			</div>
		</div>
	</div>
{/define}
