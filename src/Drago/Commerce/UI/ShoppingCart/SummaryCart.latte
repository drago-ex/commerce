{templateType Drago\Commerce\UI\ShoppingCart\SummaryCartTemplate}
{varType Drago\Commerce\Domain\Product\ProductCart[] $shoppingCart}
{import '../@breadcrumbs.latte'}

{if count($shoppingCart)}

	{* Includes the breadcrumbs component to render the navigation steps. *}
	{include breadcrumbs, $breadcrumbs}

	{* Page heading *}
	<h2 class="mb-4 fw-normal fs-4">Your shopping cart</h2>

	{* Responsive product table *}
	<div class="table-responsive">
		<table class="table table-hover table-sm align-middle table-borderless">
			<thead>
			<tr>
				<th scope="col"><small>Product name</small></th>
				<th scope="col"><small>Price</small></th>
				<th scope="col"><small>Amount</small></th>
				<th scope="col">Discount</th>
				<th scope="col"></th>
			</tr>
			</thead>
			<tbody>

			{* Loop through cart items *}
			<tr n:foreach="$shoppingCart as $cart">
				<td>{$cart->product->name}</td>

				{* Product price, right-aligned *}
				<td class="text-end">{$cart->product->price|money}</td>

				{* Quantity change form *}
				<td>
					<form n:name="changeQuantity-{$cart->product->id}" class="ajax d-flex" data-items-cart data-naja-history="replace">
						<label n:name="amount" class="w-25">
							<input n:name="amount" value="{$cart->amount}" class="form-control form-control-sm" />
						</label>
					</form>
				</td>

				{* Discount *}
				<td>
					{var $discount = $cart->product->discount ?? null}
					<span n:if="$discount" class="badge border border-danger-subtle text-danger">{$discount}%</span>
				</td>

				{* Remove item link *}
				<td>
					{var $linkAttrs = [
						'role' => "button",
						'class' => "ajax btn btn-sm btn-outline-danger",
						'aria-label' => "Remove {$cart->product->name} from cart",
						'data-naja-history' => "off"
					]}

					<a n:attr="$linkAttrs" n:href="removeItem!, productId: $cart->product->id">
						Remove
					</a>
				</td>
			</tr>

			{if $discountCode && !$discountAmount->isZero()}
				<tr>
					<td>Subtotal:</td>
					<td colspan="3" class="text-end">{$subtotalPrice|money}</td>
				</tr>
				<tr>
					<td class="text-success fw-semibold">Discount ({$discountCode}):</td>
					<td colspan="3" class="text-success fw-semibold text-end">
						-{$discountAmount|money}
					</td>
				</tr>
			{/if}

			{* Total price row *}
			<tr>
				<td class="text-danger fw-semibold">Total to pay:</td>
				<td colspan="3" class="fw-semibold text-danger text-end">
					{$totalPrice|money}
				</td>
			</tr>
			</tbody>
		</table>
	</div>

	<div class="mb-3">
		<div class="card bg-body-tertiary border-0 p-3">
			<form n:name="discountCode" class="ajax">
				<label n:name="code" class="form-label fw-semibold mb-2">
					Have a discount code?
				</label>
				<div class="d-flex align-items-start gap-2">
					<div class="flex-grow-1">
						<input n:name="code" class="form-control form-control-sm" />
						<div n:if="$form[code]->errors" class="text-danger small mt-2">
							<div n:foreach="$form[code]->errors as $error">{$error}</div>
						</div>
					</div>
					<input n:name="apply" class="btn btn-sm btn-primary px-3 flex-shrink-0" />
				</div>
			</form>
			<p n:if="$discountCode" class="small text-success mt-2 mb-0">
				Discount code <strong>{$discountCode}</strong> applied.
			</p>
		</div>
	</div>

	{* Continue to order button *}
	<p class="text-end">
		<a href="{$linkOrderDelivery}" class="btn btn-sm btn-primary">
			Continue with order
		</a>
	</p>

{else}

	{* Message for empty cart *}
	<p class="mt-2">Your shopping cart is empty.</p>

{/if}
