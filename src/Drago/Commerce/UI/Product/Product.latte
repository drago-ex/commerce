{templateType Drago\Commerce\UI\Product\ProductTemplate}

{define productImage, string $name, string $src}
	<img
			alt="{$name}"
			class="card-img-top img-fluid p-3"
			style="height: 160px; object-fit: contain;"
			loading="lazy"
			src="{$src}"
	/>
{/define}

<h1 class="h3 mt-2 mb-4">{_'Products'}</h1>
<div class="row g-3">

	{foreach $products as $product}
		<div class="col-6 col-sm-4 col-md-3 col-lg-2">
			<div class="card h-100 border-0 shadow-sm hover-shadow" role="region" aria-label="{_'Product'} {$product->name}">

				<a href="{plink detail, id: $product->id}" class="position-relative overflow-hidden d-block text-decoration-none">
					{include productImage, name: $product->name, src: "https://placehold.co/200x160?text=%20&bg=f4f6f8"}

					<span n:if="$product->hasDiscount()" class="shop-ribbon" title="{_'Discount'} {$product->getDiscountPercent()}%">
						-{$product->getDiscountPercent()}%
					</span>
				</a>

				<div class="card-body d-flex flex-column">

					<h6 class="card-title text-truncate mb-1" title="{$product->name}">
						<a href="{plink detail, id: $product->id}" class="text-decoration-none text-body-emphasis">
							{$product->name}
						</a>
					</h6>

					<p class="card-text small text-body-secondary mb-2">
						{$product->description|truncate:50}
					</p>

					<div class="mt-auto">

						<div n:if="$product->hasDiscount()" class="mb-2">
							<span class="text-body-secondary text-decoration-line-through me-2 small" aria-label="{_'Original price'}">
								{$product->getPrice()|money}
							</span>
							<span class="fw-bold text-danger d-block fs-6" aria-label="{_'Discounted price'}">
								{$product->getDiscountedPrice()|money}
							</span>
						</div>
						<p n:if="!$product->hasDiscount()" class="mb-2 fw-bold fs-6" aria-label="{_'Product price'}">
							{$product->getPrice()|money}
						</p>

						<p n:if="$product->getStock() > 5" class="small text-success mb-2 d-flex align-items-center gap-1">
								<i class="fa-solid fa-circle-check" aria-hidden="true"></i>
								{_'In stock > 5 pcs'}
						</p>
						<p n:if="$product->getStock() > 0 && $product->getStock() <= 5" class="small text-warning-emphasis mb-2 d-flex align-items-center gap-1">
								<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
								{_'In stock'}: {$product->getStock()} {_'pcs'}
						</p>
						<p n:if="$product->getStock() <= 0" class="small mb-2 text-danger d-flex align-items-center gap-1">
								<i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
								{_'Out of stock'}
						</p>

						<form n:if="$product->getStock() > 0" n:name="addToCart-{$product->id}">
							{input add, class: "btn btn-shop-accent btn-sm w-100", aria-label => "{_'Add'} {$product->name} {_'to cart'}"}
						</form>

					</div>
				</div>
			</div>
		</div>
	{/foreach}
</div>
