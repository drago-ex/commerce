{templateType Drago\Commerce\UI\Order\DeliveryTemplate}
{varType Drago\Commerce\Domain\Delivery\Carrier[] $carrier}
{varType Drago\Commerce\Domain\Delivery\Payment[] $payment}
{import '../@breadcrumbs.latte'}
{import '../@orderSummarySidebar.latte'}

{if count($shoppingCart)}

	{include breadcrumbs, $breadcrumbs}

	<h1 class="h4 mb-4 d-flex align-items-center gap-2">
		<i class="fa-solid fa-truck-fast text-body-secondary" aria-hidden="true"></i>
		{_'Information for delivery of goods'}
	</h1>

	<div class="row g-4">

		<div class="col-lg-8">
			<form n:name="delivery" n:if="count($carrier) && count($payment)">

				<p class="fw-semibold mb-2">{_'Select a transport'}</p>
				<div class="mb-4">
					{foreach $form[carrierId]->items as $key => $val}
						{var $carrierItem = null}
						{foreach $carrier as $item}
							{if $item->id === $val}{var $carrierItem = $item}{/if}
						{/foreach}

						<input n:name="carrierId:$key" class="btn-check" autocomplete="off" />
						<label n:name="carrierId:$key" class="shop-option">
							<span class="d-flex align-items-center gap-3">
								<i class="fa-solid fa-truck shop-option-icon" aria-hidden="true"></i>
								<span>{$carrierItem->name}</span>
							</span>
							<span class="fw-semibold text-nowrap">{$carrierItem->price|money}</span>
						</label>
					{/foreach}
				</div>

				<p class="fw-semibold mb-2">{_'Select a payment'}</p>
				<div class="mb-4">
					{foreach $form[paymentId]->items as $key => $val}
						{var $paymentItem = null}
						{foreach $payment as $item}
							{if $item->id === $val}{var $paymentItem = $item}{/if}
						{/foreach}

						<input n:name="paymentId:$key" class="btn-check" autocomplete="off" />
						<label n:name="paymentId:$key" class="shop-option">
							<span class="d-flex align-items-center gap-3">
								<i class="fa-solid fa-credit-card shop-option-icon" aria-hidden="true"></i>
								<span>{$paymentItem->name}</span>
							</span>
							<span class="fw-semibold text-nowrap">{$paymentItem->price|money}</span>
						</label>
					{/foreach}
				</div>

				<div class="text-end">
					<input n:name="send" class="btn btn-shop-accent" />
				</div>

			</form>
		</div>

		<div class="col-lg-4">
			{include orderSummarySidebar, $amountItems, $totalPrice, 'Shipping and payment are added once selected.'|translate}
		</div>

	</div>

{else}
	<p>{_'Your shopping cart is empty.'}</p>
{/if}
