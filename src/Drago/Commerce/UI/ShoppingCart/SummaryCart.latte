{templateType Drago\Commerce\UI\ShoppingCart\SummaryCartTemplate}
{varType Drago\Commerce\Domain\Product\ProductCart[] $shoppingCart}
{import '../@breadcrumbs.latte'}

{if count($shoppingCart)}

	{include breadcrumbs, $breadcrumbs}

	<h1 class="h4 mb-4 d-flex align-items-center gap-2">
		<i class="fa-solid fa-cart-shopping text-body-secondary" aria-hidden="true"></i>
		{_'Your shopping cart'}
	</h1>

	<div class="row g-4">

		{* Left column: cart items *}
		<div class="col-lg-8">
			<div class="vstack gap-3">

				{foreach $shoppingCart as $cart}
					<div class="card border-0 shadow-sm">
						<div class="card-body">
							<div class="row align-items-center g-3">

								<div class="col-auto">
									<img
											src="https://placehold.co/80x80?text=%20&bg=f4f6f8"
											alt="{$cart->product->name}"
											class="rounded"
											width="64"
											height="64"
									/>
								</div>

								<div class="col">
									<p class="fw-semibold mb-1">{$cart->product->name}</p>

									<div class="d-flex align-items-center gap-2 flex-wrap">
										<span class="text-body-secondary small">
											{$cart->product->getDiscountedPrice()|money} / {_'pcs'}
										</span>

										<span
												n:if="$cart->product->hasDiscount()"
												class="badge border border-danger-subtle text-danger d-inline-flex align-items-center gap-1"
										>
											<i class="fa-solid fa-tag" aria-hidden="true"></i>
											-{$cart->product->discount}%
										</span>
									</div>
								</div>

								<div class="col-auto">
									<form
											n:name="changeQuantity-{$cart->product->id}"
											class="ajax"
											data-items-cart
											data-naja-history="replace"
									>
										<label n:name="amount" class="visually-hidden">
											{_'Amount'}
										</label>
										<input
												n:name="amount"
												value="{$cart->amount}"
												class="form-control form-control-sm shop-qty-input"
										/>
									</form>
								</div>

								<div class="col-auto text-end" style="min-width: 6rem;">
									<span class="fw-semibold">
										{($cart->product->getDiscountedPrice()->multipliedBy($cart->amount))|money}
									</span>
								</div>

								<div class="col-auto">
									{var $linkAttrs = [
									'role' => 'button',
									'class' => 'ajax btn btn-sm btn-outline-danger',
									'aria-label' => "Remove {$cart->product->name} from cart",
									'data-naja-history' => 'off'
									]}

									<a
											n:attr="$linkAttrs"
											n:href="removeItem!, productId: $cart->product->id"
									>
										<i class="fa-solid fa-trash-can" aria-hidden="true"></i>
										<span class="visually-hidden">{_'Remove'}</span>
									</a>
								</div>

							</div>
						</div>
					</div>
				{/foreach}

			</div>
		</div>

		{* Right column: discount code + price summary *}
		<div class="col-lg-4">
			<div class="shop-summary-sticky">

				<div class="card border-0 shadow-sm mb-3">
					<div class="card-body">

						<form n:name="discountCode" class="ajax">

							<label n:name="code" class="form-label fw-semibold mb-2 d-flex align-items-center gap-2">
								<i class="fa-solid fa-ticket text-body-secondary" aria-hidden="true"></i>
								{_'Have a discount code?'}
							</label>

							<div class="d-flex align-items-start gap-2">
								<div class="flex-grow-1">
									<input n:name="code" class="form-control form-control-sm" />

									<div n:if="$form->errors" class="text-danger small mt-2">
										<div n:foreach="$form->errors as $error">{$error}</div>
									</div>
								</div>

								<input n:name="apply" class="btn btn-sm btn-outline-primary px-3 flex-shrink-0" />
							</div>

						</form>

						<p n:if="$discountCode" class="small text-success mt-2 mb-0 d-flex align-items-center gap-1">
							<i class="fa-solid fa-circle-check" aria-hidden="true"></i>
							{_'Discount code'} <strong>{$discountCode}</strong> {_'applied.'}
						</p>

					</div>
				</div>

				<div class="card border-0 shadow-sm">
					<div class="card-body">

						<table class="table table-sm table-borderless mb-0">
							<tbody>

							<tr n:if="!$productDiscountAmount->isZero()">
								<td>{_'Price without discount'}:</td>
								<td class="text-end text-nowrap">{$originalPrice|money}</td>
							</tr>

							<tr n:if="!$productDiscountAmount->isZero()">
								<td class="text-success">{_'Product discounts'}:</td>
								<td class="text-success text-end text-nowrap">-{$productDiscountAmount|money}</td>
							</tr>

							<tr n:if="!$productDiscountAmount->isZero() || ($discountCode && !$discountAmount->isZero())" class="border-top">
								<td class="fw-semibold">{_'Subtotal'}:</td>
								<td class="text-end fw-semibold text-nowrap">{$subtotalPrice|money}</td>
							</tr>

							<tr n:if="$discountCode && !$discountAmount->isZero()">
								<td class="text-success fw-semibold">{_'Discount'} ({$discountCode}):</td>
								<td class="text-success fw-semibold text-end text-nowrap">-{$discountAmount|money}</td>
							</tr>

							<tr class="border-top">
								<td class="text-shop-accent fw-bold fs-5">{_'Total to pay'}:</td>
								<td class="fw-bold text-shop-accent text-end text-nowrap fs-5">{$totalPrice|money}</td>
							</tr>

							</tbody>
						</table>

						<a
								href="{$linkOrderDelivery}"
								class="btn btn-shop-accent w-100 mt-2 d-flex align-items-center justify-content-center gap-2"
						>
							{_'Continue with order'}
							<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
						</a>

					</div>
				</div>

			</div>
		</div>

	</div>

{else}

	<div class="text-center py-5">
		<i class="fa-solid fa-cart-shopping fa-2x text-body-secondary mb-3" aria-hidden="true"></i>
		<p class="mb-0">{_'Your shopping cart is empty.'}</p>
	</div>

{/if}
