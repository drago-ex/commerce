{templateType Drago\Commerce\UI\Product\ProductTemplate}

{define productImage, string $name, string $src}
	<img
			alt="{$name}"
			class="card-img-top img-fluid p-3"
			style="height: 160px; object-fit: contain;"
			loading="lazy"
			src="{$src}"
	/>
{/define}

<h1 class="h3 mt-2 mb-4">{_'Products'}</h1>
<div class="row g-3">

	{foreach $products as $product}
		<div class="col-6 col-sm-4 col-md-3 col-lg-2">
			<div class="card h-100 border-0 shadow-sm hover-shadow" role="region" aria-label="{_'Product'} {$product->name}">

				<a href="{plink detail, id: $product->id}" class="position-relative overflow-hidden d-block text-decoration-none">
					{include productImage, name: $product->name, src: "https://placehold.co/200x160?text=%20&bg=f4f6f8"}

					<span n:if="$product->hasDiscount() && (!isset($variantSummaries[$product->id]) || $variantSummaries[$product->id]->inheritsPrice)" class="shop-ribbon" title="{_'Discount'} {$product->getDiscountPercent()}%">
						-{$product->getDiscountPercent()}%
					</span>
				</a>

				<div class="card-body d-flex flex-column">

					<h6 class="card-title text-truncate mb-1" title="{$product->name}">
						<a href="{plink detail, id: $product->id}" class="text-decoration-none text-body-emphasis">
							{$product->name}
						</a>
					</h6>

					<p class="card-text small text-body-secondary mb-2">
						{$product->description|truncate:50}
					</p>

					{var $summary = $variantSummaries[$product->id] ?? null}
					{var $stock = $summary ? $summary->stock : $product->getStock()}

					<div class="mt-auto">

						{if $summary}
							<p class="mb-2 fw-bold fs-6" aria-label="{_'Product price'}">
								<span class="fw-normal small text-body-secondary">{_'from'}</span>
								{$lowestPrices[$product->id]|money}
							</p>
						{elseif $product->hasDiscount()}
							<div class="mb-2">
								<span class="text-body-secondary text-decoration-line-through me-2 small" aria-label="{_'Original price'}">
									{$product->getPrice()|money}
								</span>
								<span class="fw-bold text-danger d-block fs-6" aria-label="{_'Discounted price'}">
									{$product->getDiscountedPrice()|money}
								</span>
							</div>
						{else}
							<p class="mb-2 fw-bold fs-6" aria-label="{_'Product price'}">
								{$product->getPrice()|money}
							</p>
						{/if}

						<p n:if="$stock > 5" class="small text-success mb-2 d-flex align-items-center gap-1">
							<i class="fa-solid fa-circle-check" aria-hidden="true"></i>
							{_'In stock > 5 pcs'}
						</p>
						<p n:if="$stock > 0 && $stock <= 5" class="small text-warning-emphasis mb-2 d-flex align-items-center gap-1">
							<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
							{_'In stock'}: {$stock} {_'pcs'}
						</p>
						<p n:if="$stock <= 0" class="small mb-2 text-danger d-flex align-items-center gap-1">
							<i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
							{_'Out of stock'}
						</p>

						{if $summary}
							<a
									n:if="$stock > 0"
									href="{plink detail, id: $product->id}"
									class="btn btn-shop-accent btn-sm w-100"
									aria-label="{_'Choose variant'}: {$product->name}"
							>
								{_'Choose variant'}
							</a>
						{else}
							<form n:if="$stock > 0" n:name="addToCart-{$product->id}">
								{capture $addLabel}{_'Add'} {$product->name} {_'to cart'}{/capture}
								{input add, class: "btn btn-shop-accent btn-sm w-100", aria-label => $addLabel}
							</form>
						{/if}

					</div>
				</div>
			</div>
		</div>
	{/foreach}
</div>

<nav n:if="$paginator && $paginator->getPageCount() > 1" aria-label="{_'Pagination'}" class="mt-4">
	<ul class="pagination justify-content-center">
		<li n:class="page-item, $paginator->isFirst() ? disabled">
			<a class="page-link" href="{link this, page: max(1, $paginator->getPage() - 1)}" n:attr="tabindex => $paginator->isFirst() ? -1 : null">{_'Previous'}</a>
		</li>
		{for $i = 1; $i <= $paginator->getPageCount(); $i++}
			<li n:class="page-item, $i === $paginator->getPage() ? active">
				<a class="page-link" href="{link this, page: $i}" n:attr="aria-current => $i === $paginator->getPage() ? 'page' : null">{$i}</a>
			</li>
		{/for}
		<li n:class="page-item, $paginator->isLast() ? disabled">
			<a class="page-link" href="{link this, page: min($paginator->getPageCount(), $paginator->getPage() + 1)}" n:attr="tabindex => $paginator->isLast() ? -1 : null">{_'Next'}</a>
		</li>
	</ul>
</nav>
