{templateType Drago\Commerce\UI\Product\ProductTemplate}
{varType Drago\Commerce\Domain\Product\ProductEntity[] $products}

{define productImage, string $name, string $src}
	<img
			alt="{$name}"
			class="card-img-top img-fluid p-3"
			style="height: 160px; object-fit: contain;"
			loading="lazy"
			src="{$src}"
	/>
{/define}

<h1 class="h3 mt-2 mb-4">{_'Products'}</h1>
<div class="row g-3">

	{foreach $products as $product}
		<div class="col-6 col-sm-4 col-md-3 col-lg-2">
			<div class="card h-100 border-0 shadow-sm hover-shadow" role="region" aria-label="{_'Product'} {$product->name}">

				<div class="position-relative overflow-hidden">
					{var $imageSrc = "https://placehold.co/200x160?text=%20&bg=f4f6f8"}
					{include productImage, name: $product->name, src: $imageSrc}

					<span n:if="$product->hasDiscount()" class="shop-ribbon" title="{_'Discount'} {$product->getDiscountPercent()}%">
						-{$product->getDiscountPercent()}%
					</span>
				</div>

				<div class="card-body d-flex flex-column">

					<h6 class="card-title text-truncate mb-1" title="{$product->name}">
						{$product->name}
					</h6>

					<p class="card-text small text-body-secondary mb-2">
						{$product->description|truncate:50}
					</p>

					<div class="mt-auto">

						{if $product->hasDiscount()}
							<div class="mb-2">
								<span class="text-body-secondary text-decoration-line-through me-2 small" aria-label="Original price">
									{$product->getPrice()|money}
								</span>
								<span class="fw-bold text-danger d-block fs-6" aria-label="Discounted price">
									{$product->getDiscountedPrice()|money}
								</span>
							</div>
						{else}
							<p class="mb-2 fw-bold fs-6" aria-label="Product price">
								{$product->getPrice()|money}
							</p>
						{/if}

						{if $product->getStock() > 5}
							<p class="small text-success mb-2 d-flex align-items-center gap-1">
								<i class="fa-solid fa-circle-check" aria-hidden="true"></i>
								{_'In stock > 5 pcs'}
							</p>
						{elseif $product->getStock() > 0}
							<p class="small text-warning-emphasis mb-2 d-flex align-items-center gap-1">
								<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
								{_'In stock'}: {$product->getStock()} {_'pcs'}
							</p>
						{else}
							<p class="small mb-2 text-danger d-flex align-items-center gap-1">
								<i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
								{_'Out of stock'}
							</p>
						{/if}

						{if $product->getStock() > 0}
							<form n:name="addToCart-{$product->id}">
								{input add, class: "btn btn-shop-accent btn-sm w-100", aria-label => "{_'Add'} {$product->name} {_'to cart'}"}
							</form>
						{/if}

					</div>
				</div>
			</div>
		</div>
	{/foreach}
</div>
