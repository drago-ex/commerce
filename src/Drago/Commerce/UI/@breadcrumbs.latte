{varType \Drago\Commerce\UI\Breadcrumbs $breadcrumbs}
{define breadcrumbs, $breadcrumbs}
	{var $icons = [
		'shoppingCart' => 'fa-solid fa-cart-shopping',
		'delivery' => 'fa-solid fa-truck',
		'customer' => 'fa-solid fa-user',
		'summary' => 'fa-solid fa-clipboard-check',
	]}

	<nav class="commerce-checkout-steps" aria-label="{_'Checkout steps'}">
		<ol>
			{foreach $breadcrumbs->steps as $step => $label}
				{var $completed = in_array($step, $breadcrumbs->completedSteps, true)}
				{var $current = $step === $breadcrumbs->currentStep}
				<li n:class="'commerce-checkout-step', $completed ? 'is-completed', $current ? 'is-current', !$completed && !$current ? 'is-upcoming'">
					{if $completed}
						<a href="{plink $step}" aria-label="{$label|translate}">
					{else}
						<span n:attr="aria-current: $current ? 'step' : null">
					{/if}
						<span class="commerce-checkout-step__icon">
							<i class="{$icons[$step] ?? 'fa-solid fa-circle'}" aria-hidden="true"></i>
						</span>
						<span class="commerce-checkout-step__label">{$label|translate}</span>
					{if $completed}</a>{else}</span>{/if}
				</li>
			{/foreach}
		</ol>
	</nav>
{/define}
