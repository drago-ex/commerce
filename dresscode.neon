use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

fileExtensions:
	- php
	- phpt

# properties of entities and value objects carry the names of database columns
naming: {property: keep}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
