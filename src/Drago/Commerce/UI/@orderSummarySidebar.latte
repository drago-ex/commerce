{define orderSummarySidebar, int $amountItems, \Brick\Money\Money $totalPrice, ?string $note = null}
	<div class="shop-summary-sticky">
		<div class="card border-0 shadow-sm">
			<div class="card-body">
				<p class="fw-semibold d-flex align-items-center gap-2 mb-3">
					<i class="fa-solid fa-receipt text-body-secondary" aria-hidden="true"></i>
					{_'Order summary'}
				</p>

				<div class="d-flex justify-content-between mb-2">
					<span class="text-body-secondary">{_'Items'}:</span>
					<span>{$amountItems}</span>
				</div>

				<div class="d-flex justify-content-between border-top pt-2">
					<span class="fw-bold fs-5">{_'Total'}:</span>
					<span class="fw-bold fs-5 text-shop-accent">{$totalPrice|money}</span>
				</div>

				<p n:if="$note" class="small text-body-secondary mt-3 mb-0">
					<i class="fa-solid fa-circle-info" aria-hidden="true"></i>
					{$note}
				</p>
			</div>
		</div>
	</div>
{/define}
