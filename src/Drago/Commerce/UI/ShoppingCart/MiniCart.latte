{templateType Drago\Commerce\UI\ShoppingCart\MiniCartTemplate}

<a
		href="{$linkShoppingCart}"
		class="shop-minicart"
		aria-label="{_'Go to shopping cart'}. {_'Number of items'}: {$amountItems}, {_'total price'}: {$formattedTotalPrice}"
>
	<span class="shop-minicart-icon-wrap">
		<i class="fa-solid fa-cart-shopping shop-minicart-icon" aria-hidden="true"></i>

		<span
				n:if="$amountItems > 0"
				class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
				aria-live="polite"
		>
			{$amountItems}
		</span>
	</span>

	<span class="fw-semibold">{$formattedTotalPrice}</span>
</a>
