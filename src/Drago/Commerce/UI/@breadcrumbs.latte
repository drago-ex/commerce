{varType \Drago\Commerce\UI\Breadcrumbs $breadcrumbs}
{define breadcrumbs, $breadcrumbs}
	<nav aria-label="Checkout progress" class="mb-4 mt-3 pb-3 border-bottom">
		<ol class="shop-stepper">
			{foreach $breadcrumbs->steps as $step => $label}
				{var $isCurrent = $step === $breadcrumbs->currentStep}
				{var $isDone = in_array($step, $breadcrumbs->completedSteps, true)}

				<li n:class="shop-stepper-item, $isCurrent ? 'is-current', $isDone ? 'is-done'">

					{if $isDone}
						<a href="{plink $step}" class="d-flex align-items-center text-decoration-none">
							<span class="shop-stepper-badge">
								<i class="fa-solid fa-check" aria-hidden="true"></i>
							</span>
							<span class="shop-stepper-label">{$label}</span>
						</a>
					{else}
						<span class="d-flex align-items-center" aria-current="{$isCurrent ? 'step' : null}">
							<span class="shop-stepper-badge">{$iterator->counter}</span>
							<span class="shop-stepper-label">{$label}</span>
						</span>
					{/if}

					<span class="shop-stepper-line" aria-hidden="true"></span>
				</li>
			{/foreach}
		</ol>
	</nav>
{/define}
