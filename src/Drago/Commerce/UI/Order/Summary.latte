{templateType Drago\Commerce\UI\Order\SummaryOrderTemplate}
{varType Drago\Commerce\Domain\Product\ProductCart[] $shoppingCart}
{import '../@breadcrumbs.latte'}

{if count($shoppingCart)}

	{* Includes the breadcrumbs component to render the navigation steps. *}
	{include breadcrumbs, $breadcrumbs}

	{* Pre-shipment summary heading *}
	<h2 class="mb-4 fw-normal fs-4">{_'Pre-shipment summary'}</h2>

	{* Products and costs summary table *}
	<div class="table-responsive mb-4">
		<table class="table table-borderless table-hover align-middle">
			<thead>
			<tr>
				<th scope="col"><small>{_'Product name'}</small></th>
				<th scope="col" class="text-end"><small>{_'Price'}</small></th>
				<th scope="col" class="text-center"><small>{_'Amount'}</small></th>
				<th scope="col" class="text-center"><small>{_'Discount'}</small></th>
			</tr>
			</thead>
			<tbody>

			{* Loop through cart products  *}
			<tr n:foreach="$shoppingCart as $cart">
				<td>{$cart->product->name}</td>
				<td class="text-end">{$cart->product->price|money}</td>
				<td class="text-center">{$cart->amount}</td>
				<td class="text-center">
					{var $discount = $cart->product->discount ?? null}
					<span n:if="$discount" class="badge border border-danger-subtle text-danger">
						{$discount}%
					</span>
				</td>
			</tr>

			{* Subtotal and discount code, shown only when a code is actually applied *}
			{if $discountCode && !$discountAmount->isZero()}
				<tr class="border-top">
					<td colspan="3" class="fw-semibold">{_'Subtotal'}:</td>
					<td class="text-end fw-semibold">{$subtotalPrice|money}</td>
				</tr>
				<tr>
					<td colspan="3" class="text-success fw-semibold">{_'Discount'} ({$discountCode}):</td>
					<td class="text-success fw-semibold text-end">-{$discountAmount|money}</td>
				</tr>
			{/if}

			<tr>
				<td><strong class="fw-semibold">{$carrier->name}</strong></td>
				<td colspan="3" class="text-end">{$carrier->price|money}</td>
			</tr>

			{* Payment method and cost  *}
			<tr>
				<td><strong class="fw-semibold">{$payment->name}</strong></td>
				<td colspan="3" class="text-end">{$payment->price|money}</td>
			</tr>

			</tbody>
		</table>
	</div>

	{* Total price to pay outside the table for better emphasis *}
	<p class="text-end text-danger fw-semibold fs-5 mb-4">
		{_'Total to pay'}: {$totalPrice|money}
	</p>

	{* Customer information summary *}
	<h2 class="mb-4 fw-normal fs-4 pb-2 border-bottom">{_'Customer information'}</h2>
	<div class="mb-4">
		<p class="mb-2">
			<strong class="fw-semibold">{_'Name and surname'}:</strong><br>
			{$customer->name} {$customer->surname}
		</p>
		<p class="mb-2">
			<strong class="fw-semibold">{_'Email'}:</strong><br>
			{$customer->email}
		</p>
		<p class="mb-2">
			<strong class="fw-semibold">{_'Telephone'}:</strong><br>
			{$customer->phone->format(Brick\PhoneNumber\PhoneNumberFormat::INTERNATIONAL)}
		</p>
		<p class="mb-2">
			<strong class="fw-semibold">{_'Delivery address'}:</strong><br>
			{$customer->street}<br>
			{$customer->postal_code} {$customer->city}<br>
			{$customer->country}
		</p>
		{if $customer->note}
			<p class="mb-0"><strong class="fw-semibold">{_'Order note'}:</strong><br>
				{$customer->note ?? null}
			</p>
		{/if}
	</div>

	{* Confirm purchase button with accessibility label *}
	<div class="text-end mt-3">
		<form n:name="sendOrder" n:if="$customer !== null && $carrier !== null">
			<input n:name="send" class="btn btn-sm btn-success" aria-label="{_'Confirm your order and complete the purchase'}">
		</form>
	</div>

{else}
	<p>{_'Your shopping cart is empty.'}</p>
{/if}
